{
  "name": "music-maker-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "openspec": "openspec",
    "specs:check": "openspec validate --all --strict --no-interactive",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "format:check": "prettier --config config/prettier.json --check frontend/src frontend/*.json config/*.json config/*.mjs scripts/*.mjs tests/e2e package.json",
    "e2e": "playwright test --config config/playwright.config.mjs",
    "release": "semantic-release --extends ./config/release.config.mjs"
  },
  "overrides": {
    "postcss": "8.5.29"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "@playwright/test": "1.64.0",
    "@fission-ai/openspec": "1.14.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  }
}
